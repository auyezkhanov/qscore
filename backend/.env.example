DATABASE_URL="postgresql://qscore:qscore@localhost:15432/qscore?schema=public"
PORT=14000
# Comma-separated; "*" allows any origin.
CORS_ORIGIN="http://localhost:15173"
# At least 16 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional: enables English translations of news articles.
DEEPL_API_KEY=""
# Background sync with kffleague.kz
SYNC_ENABLED=true
LIVE_SYNC_INTERVAL_SEC=60
FULL_SYNC_INTERVAL_MIN=360
# Market values and transfer fees from transfermarkt.com (see README)
TM_SYNC_ENABLED=true
TM_SYNC_INTERVAL_HOURS=24
# Public site URL used in calendar feeds and push notifications
PUBLIC_URL="http://localhost:15173"
