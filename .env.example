# Used by docker-compose. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Database password (only used inside docker; the port is bound to localhost)
POSTGRES_PASSWORD=qscore
# Optional: English translations of news via DeepL
DEEPL_API_KEY=
# Host ports (defaults avoid the usual 5432/4000/5173)
POSTGRES_PORT=15432
API_PORT=14000
WEB_PORT=15173
# Public site URL (calendar links, push notifications)
PUBLIC_URL=http://localhost:15173
